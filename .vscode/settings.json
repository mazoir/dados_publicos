{
    // pipeline_rais_caged.ps1 precisa continuar em UTF-8 COM BOM: sem o BOM, o Windows PowerShell 5.1
    // lê os acentos errado. O VS Code mantém o BOM dos arquivos que já têm; esta linha garante o mesmo
    // para arquivos .ps1 novos ou salvos sem BOM por outro editor.
    "[powershell]": {
        "files.encoding": "utf8bom",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // Mesmo estilo do script: chave de abertura na mesma linha.
    "powershell.codeFormatting.preset": "OTBS"
}
