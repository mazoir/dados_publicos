{
    // Tarefas do pipeline RAIS + Novo CAGED. Para rodar: Terminal > Run Task... (ou Ctrl+Shift+P > "Tasks: Run Task")
    // e escolha uma das tarefas "MTE". Cada tarefa abre um PowerShell novo, num painel próprio do terminal, onde
    // aparecem as barras de progresso; o código de saída (0, 1 ou 2) aparece no fim.
    // Guia: docs/rais_caged_mg.md, seção 16.
    "version": "2.0.0",
    "inputs": [
        {
            "id": "powershell",
            "type": "pickString",
            "description": "Qual PowerShell roda o pipeline? (powershell.exe = Windows PowerShell 5.1; pwsh = PowerShell 7)",
            "options": ["powershell.exe", "pwsh"],
            "default": "powershell.exe"
        },
        {
            "id": "saida",
            "type": "promptString",
            "description": "Pasta de saída (CSVs, manifesto e logs)",
            "default": "C:\\Dados\\MTE"
        },
        {
            "id": "uf",
            "type": "pickString",
            "description": "UF filtrada",
            "options": [
                "MG", "AC", "AL", "AM", "AP", "BA", "CE", "DF", "ES", "GO", "MA", "MS", "MT", "PA",
                "PB", "PE", "PI", "PR", "RJ", "RN", "RO", "RR", "RS", "SC", "SE", "SP", "TO"
            ],
            "default": "MG"
        },
        {
            "id": "bases",
            "type": "pickString",
            "description": "Bases (RAIS = vínculos + estabelecimentos; CAGED = MOV + FOR + EXC)",
            "options": ["RAIS,CAGED", "RAIS", "CAGED", "RAIS_VINC", "RAIS_ESTAB", "CAGED_MOV", "CAGED_FOR", "CAGED_EXC"],
            "default": "RAIS,CAGED"
        },
        {
            "id": "anoInicial",
            "type": "promptString",
            "description": "Ano inicial (2020 ou depois; o ano final é o corrente)",
            "default": "2020"
        },
        {
            "id": "anoTeste",
            "type": "promptString",
            "description": "Ano do teste rápido (só o CAGED de exclusões, poucos MB)",
            "default": "2025"
        }
    ],
    "tasks": [
        {
            "label": "MTE 1 - Simulação (lista o FTP, não baixa nada)",
            "detail": "-SomenteListar: mostra o que existe no FTP e o que seria baixado/processado",
            "type": "process",
            "command": "${input:powershell}",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/pipeline_rais_caged.ps1",
                "-Saida", "${input:saida}", "-UF", "${input:uf}", "-Bases", "${input:bases}",
                "-AnoInicial", "${input:anoInicial}", "-SomenteListar"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true, "showReuseMessage": false }
        },
        {
            "label": "MTE 2 - Teste rápido (CAGED exclusões de um ano)",
            "detail": "Baixa e processa só o CAGED_EXC do ano escolhido: confere FTP, 7-Zip e ETL em poucos minutos",
            "type": "process",
            "command": "${input:powershell}",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/pipeline_rais_caged.ps1",
                "-Saida", "${input:saida}", "-UF", "${input:uf}", "-Bases", "CAGED_EXC",
                "-AnoInicial", "${input:anoTeste}", "-AnoFinal", "${input:anoTeste}"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true, "showReuseMessage": false }
        },
        {
            "label": "MTE 3 - Carga completa (CSV)",
            "detail": "Bases e período escolhidos, com CSV consolidado por grupo no final (incremental: só o que é novo)",
            "type": "process",
            "command": "${input:powershell}",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/pipeline_rais_caged.ps1",
                "-Saida", "${input:saida}", "-UF", "${input:uf}", "-Bases", "${input:bases}",
                "-AnoInicial", "${input:anoInicial}", "-Consolidar"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true, "showReuseMessage": false }
        },
        {
            "label": "MTE 4 - Carga completa (CSV compactado .gz)",
            "detail": "Igual à 3, gravando .csv.gz (8 a 10 vezes menor; o Power Query lê com Binary.Decompress)",
            "type": "process",
            "command": "${input:powershell}",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/pipeline_rais_caged.ps1",
                "-Saida", "${input:saida}", "-UF", "${input:uf}", "-Bases", "${input:bases}",
                "-AnoInicial", "${input:anoInicial}", "-Consolidar", "-CompactarSaida"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true, "showReuseMessage": false }
        },
        {
            "label": "MTE 5 - Acompanhar o log mais recente (ao vivo)",
            "detail": "Mostra o fim do log da última execução e segue as linhas novas (ex.: tarefa agendada rodando). Feche com a lixeira do terminal",
            "type": "process",
            "command": "${input:powershell}",
            "args": [
                "-NoProfile", "-Command",
                "$pasta = Join-Path -Path '${input:saida}' -ChildPath '_controle\\logs'; $log = Get-ChildItem -LiteralPath $pasta -Filter 'execucao_*.log' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime | Select-Object -Last 1; if ($null -eq $log) { Write-Host ('Nenhum log em ' + $pasta) } else { Write-Host ('Acompanhando ' + $log.FullName); Get-Content -LiteralPath $log.FullName -Tail 40 -Wait }"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true, "showReuseMessage": false }
        }
    ]
}
